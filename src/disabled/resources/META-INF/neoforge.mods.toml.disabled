# Optional dependencies of the compats in src/disabled, as they are in neoforge.mods.toml for Minecraft 1.21.1 (Paragliders: for 26.2).

[[dependencies.${mod_id}]]
modId = "parcool"
type = "optional"
versionRange = "[4.0,)"
# BEFORE: ParCool posts its stamina type registration event from its constructor, so AoS must be constructed first
# to add its listener to ParCool's mod bus.
ordering = "BEFORE"
side = "BOTH"

[[dependencies.${mod_id}]]
modId = "epicfight"
type = "optional"
versionRange = "[21.17,)"
ordering = "AFTER"
side = "BOTH"

[[dependencies.${mod_id}]]
modId = "vc_gliders"
type = "optional"
versionRange = "[1.1,)"
ordering = "NONE"
side = "BOTH"

[[dependencies.${mod_id}]]
modId = "create"
type = "optional"
versionRange = "[6.0,)"
ordering = "NONE"
side = "BOTH"

[[dependencies.${mod_id}]]
modId = "paraglider"
type = "optional"
versionRange = "[26.2,26.3)"
ordering = "NONE"
side = "BOTH"
